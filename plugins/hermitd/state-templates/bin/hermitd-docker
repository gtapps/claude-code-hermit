#!/usr/bin/env bash
# Bootstrap older host cores, then delegate to the plugin implementation.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/../.."

# Priority: HERMIT_PLUGIN_ROOT env var > scan ~/.claude/plugins/
# No config.json dependency — works in both host and Docker without path conflicts.

PLUGIN_ROOT=""

# Confirm a directory carries the hermitd plugin manifest.
_is_core_root() {
  [ -f "$1/.claude-plugin/plugin.json" ] || return 1
  local n
  n=$(grep -o '"name"[^,]*' "$1/.claude-plugin/plugin.json" 2>/dev/null | head -1 | cut -d'"' -f4)
  [ "$n" = "hermitd" ]
}

# 1. Env var (set by docker-entrypoint) — accepted only if it actually points at
# core's plugin root. A stale/foreign value is ignored (not fatal), so a bad hint
# never boots the wrong tree and never blocks the scan below.
if [ -n "${HERMIT_PLUGIN_ROOT:-}" ] && [ -d "$HERMIT_PLUGIN_ROOT" ]; then
  if _is_core_root "$HERMIT_PLUGIN_ROOT"; then
    PLUGIN_ROOT="$HERMIT_PLUGIN_ROOT"
  else
    echo "[hermit] HERMIT_PLUGIN_ROOT does not point at hermitd; ignoring: $HERMIT_PLUGIN_ROOT" >&2
  fi
fi

# 2. Scan marketplace cache for the hermitd plugin under
# plugins/<name>/ (monorepo layout — gtapps/hermitd ships as a
# multi-plugin marketplace). Collect ALL matches and fail loud on ambiguity
# (two marketplaces shipping core) rather than silently taking glob order.
if [ -z "$PLUGIN_ROOT" ]; then
  SEARCH_BASE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  _old_nullglob=$(shopt -p nullglob 2>/dev/null || true)
  shopt -s nullglob
  _matches=()
  for d in "$SEARCH_BASE"/plugins/marketplaces/*/plugins/*/; do
    if [ -d "$d/scripts" ] && _is_core_root "${d%/}"; then
      _matches+=("${d%/}")
    fi
  done
  $_old_nullglob
  # Each glob match is a distinct marketplace/plugin path, so _matches never holds
  # duplicates — count the array directly instead of a sort -u no-op on the boot path.
  if [ "${#_matches[@]}" -gt 0 ]; then
    if [ "${#_matches[@]}" -gt 1 ]; then
      echo "[hermit] Ambiguous hermitd install — multiple marketplaces provide it:" >&2
      printf '[hermit]   %s\n' "${_matches[@]}" >&2
      echo "[hermit] Set HERMIT_PLUGIN_ROOT to the one to use." >&2
      exit 1
    fi
    PLUGIN_ROOT="${_matches[0]}"
  fi
fi

if [ -z "$PLUGIN_ROOT" ] || [ ! -d "$PLUGIN_ROOT" ]; then
  echo "[hermit] Plugin root not found or invalid: $PLUGIN_ROOT" >&2
  echo "[hermit] Run /hermitd:hermit-evolve inside Claude Code to fix." >&2
  exit 1
fi


if [ ! -f "$PLUGIN_ROOT/scripts/hermitd-docker.sh" ]; then
  case "$PLUGIN_ROOT" in
    */marketplaces/*/plugins/*) MP="${PLUGIN_ROOT#*/marketplaces/}"; MP="${MP%%/*}" ;;
    */cache/*/hermitd/*) MP="${PLUGIN_ROOT#*/cache/}"; MP="${MP%%/*}" ;;
    *) echo "[hermit] Cannot determine marketplace for $PLUGIN_ROOT" >&2; exit 1 ;;
  esac
  # Prints "<scope><TAB><installPath>" for the core install this project loads.
  _core_install() {
    claude plugin list --json | bun -e '
      const rows = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const [id, project] = process.argv.slice(1);
      const here = rows.filter(p => p.id === id && p.enabled === true && (p.scope === "user" || p.projectPath === project));
      for (const scope of ["local", "project", "user"]) {
        const matches = here.filter(p => p.scope === scope);
        if (!matches.length) continue;
        if (matches.length === 1 && typeof matches[0].installPath === "string") console.log(scope + "\t" + matches[0].installPath);
        break;
      }
    ' "hermitd@$MP" "$PWD" 2>/dev/null
  }
  # claude plugin update needs the explicit scope; the default misses local and project installs.
  SCOPE=$(_core_install | cut -f1) || SCOPE=""
  if [ -z "$SCOPE" ]; then
    echo "[hermit] hermitd@$MP is not installed and enabled for $PWD." >&2
    exit 1
  fi
  if ! claude plugin update "hermitd@$MP" --scope "$SCOPE"; then
    echo "[hermit] Bootstrap failed. Run: claude plugin update hermitd@$MP --scope $SCOPE" >&2
    exit 1
  fi
  # Versioned cache directories do not move in place after an update.
  if [ ! -f "$PLUGIN_ROOT/scripts/hermitd-docker.sh" ]; then
    FRESH_ROOT=$(_core_install | cut -f2) || FRESH_ROOT=""
    if [ -n "$FRESH_ROOT" ] && _is_core_root "$FRESH_ROOT"; then PLUGIN_ROOT="$FRESH_ROOT"; fi
  fi
  if [ ! -f "$PLUGIN_ROOT/scripts/hermitd-docker.sh" ]; then
    echo "[hermit] Still missing hermitd-docker.sh. Run: claude plugin update hermitd@$MP --scope $SCOPE" >&2
    exit 1
  fi
fi
export HERMIT_PLUGIN_ROOT="$PLUGIN_ROOT"
exec "$SCRIPT_DIR/hermitd-run" hermitd-docker "$@"
