#!/usr/bin/env bash
# claude-code-hermit: managed host CLI
set -euo pipefail
BINDING=__HERMIT_BINDING__
UPDATE_ID=__HERMIT_UPDATE_ID__
# Prefer the install recorded at `hermit-cli install`; when that one is gone (its
# project uninstalled or deleted), fall back to any other core install; Claude Code reports enabled from the caller's settings.
if ! INSTALL_PATH=$(claude plugin list --json | bun -e '
const fs = require("fs");
try {
  let binding = {};
  try { binding = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch {}
  const list = JSON.parse(fs.readFileSync(0, "utf8"));
  const usable = p => p.id === process.argv[2] && typeof p.installPath === "string" && fs.existsSync(p.installPath + "/scripts/hermit-exec.sh");
  // Same precedence Claude Code loads by: the bound install, then local and project installs of the same project, then user, then any.
  const rank = p => p.scope === binding.scope && p.projectPath === binding.projectPath ? 0
    : p.projectPath === binding.projectPath && p.scope === "local" ? 1
    : p.projectPath === binding.projectPath && p.scope === "project" ? 2
    : p.scope === "user" ? 3 : 4;
  const pick = list.filter(usable).sort((a, b) => rank(a) - rank(b))[0];
  if (!pick) process.exit(1);
  console.log(pick.installPath);
} catch { process.exit(1); }
' "$BINDING" "$UPDATE_ID"); then
  echo "[hermit] No usable $UPDATE_ID install found. Update it with: claude plugin update $UPDATE_ID --scope <user|project|local>" >&2
  exit 1
fi
exec bash "$INSTALL_PATH/scripts/hermit-exec.sh" hermit-cli "$@"
