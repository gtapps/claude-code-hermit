{
  "description": "Home Assistant safety gates.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__homeassistant__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/mcp-safety-gate.ts"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/curl-host-gate.ts"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
